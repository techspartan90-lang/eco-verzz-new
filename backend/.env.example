# Django Settings
SECRET_KEY=django-insecure-your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# PostgreSQL Configuration
DB_NAME=ecoverzz_db
DB_USER=ecoverzz_user
DB_PASSWORD=ecoverzz_password
DB_HOST=postgres
DB_PORT=5432

# Redis & Celery
REDIS_URL=redis://redis:6379/0
